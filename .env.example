# URL publique de l'application (utilisée dans les emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Configuration SMTP (envoi d'emails) ──────────────────────────────────────
# Gmail : activez "Mots de passe d'application" dans votre compte Google
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre-email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx   # Mot de passe d'application Google
# SMTP_FROM=Koji <votre-email@gmail.com>

# OVH / Infomaniak / autre hébergeur SMTP
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=587
# SMTP_USER=contact@votre-domaine.fr
# SMTP_PASS=votre-mot-de-passe
# SMTP_FROM=Koji <contact@votre-domaine.fr>

# ── Supabase (base de données + comptes partagés avec l'app mobile) ─────────
# Mêmes valeurs que koji-admin / koji-main
NEXT_PUBLIC_SUPABASE_URL=https://hbgqbpyufaajqmedxodg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ── Stripe (abonnements) ─────────────────────────────────────────────────────
# Clé secrète du Dashboard Stripe (Développeurs → Clés API). Utilisez la clé
# "test" tant que les paiements ne sont pas passés en production.
# STRIPE_SECRET_KEY=sk_test_...
# Signature du webhook (Développeurs → Webhooks → votre endpoint → "Signing secret").
# STRIPE_WEBHOOK_SECRET=whsec_...
# Générés une fois via `node --env-file=.env.local scripts/stripe-setup.js`.
# STRIPE_PRICE_GO_MONTHLY=price_...
# STRIPE_PRICE_GO_YEARLY=price_...
# STRIPE_PRICE_PREMIUM_MONTHLY=price_...
# STRIPE_PRICE_PREMIUM_YEARLY=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_YEARLY=price_...

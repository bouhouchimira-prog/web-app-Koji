# Copiez ce fichier en .env.e2e (jamais versionne, voir .gitignore) et
# remplissez les valeurs necessaires. Un identifiant manquant => les tests
# qui en ont besoin sont "skipped", jamais en echec.

# URL de l'app a tester (npm run dev par defaut)
E2E_BASE_URL=http://localhost:3000

# 1 = Chrome headless (CI/terminal), 0 = fenetre visible (debug)
E2E_HEADLESS=1

# Compte entreprise (Koji Pro) reel, non-admin de preference pour tester
# aussi les redirections /abonnement si son essai/premium n'est pas actif.
E2E_ENTREPRISE_EMAIL=
E2E_ENTREPRISE_PASSWORD=

# Compte particulier (Koji) reel.
E2E_PARTICULIER_EMAIL=
E2E_PARTICULIER_PASSWORD=

# 1 = autorise les tests qui CREENT de vraies donnees (prefixees
# "E2E-<horodatage>", nettoyees dans un after()). 0 = ces tests sont skipped.
E2E_WRITE=0

# 1 = autorise les tests qui appellent reellement l'assistant IA (payant).
# 0 = ces tests sont skipped.
E2E_AI=0
